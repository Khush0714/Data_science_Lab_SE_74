        "import numpy as np\n",
        "\n",
        "# Define the coefficient matrix A\n",
        "A = np.array([[2, 3],\n",
        "              [4, 5]])\n",
        "\n",
        "# Define the constant vector B\n",
        "B = np.array([10, 20])\n",
        "\n",
        "# Solve the system of linear equations Ax = B\n",
        "solution = np.linalg.solve(A, B)\n",
        "\n",
        "print(\"Coefficient Matrix A:\")\n",
        "print(A)\n",
        "print(\"\\nConstant Vector B:\")\n",
        "print(B)\n",
        "print(\"\\nSolution (x, y):\")\n",
        "print(solution)"
      ],
      "execution_count": 15,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Coefficient Matrix A:\n",
            "[[2 3]\n",
            " [4 5]]\n",
            "\n",
            "Constant Vector B:\n",
            "[10 20]\n",
            "\n",
            "Solution (x, y):\n",
            "[5. 0.]\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Coefficients\n",
        "a1 = 2\n",
        "b1 = 3\n",
        "c1 = 10\n",
        "\n",
        "a2 = 4\n",
        "b2 = 5\n",
        "c2 = 20\n",
        "\n",
        "# Multiply equation 1 by 2 so x coefficients match\n",
        "a1_new = a1 * 2\n",
        "b1_new = b1 * 2\n",
        "c1_new = c1 * 2\n",
        "\n",
        "# Now subtract eq2 from modified eq1\n",
        "# (4x + 6y = 20) minus (4x + 5y = 20)\n",
        "y = (c1_new - c2) / (b1_new - b2)\n",
        "\n",
        "# Substitute y back into eq1 to find x\n",
        "x = (c1 - b1 * y) / a1\n",
        "\n",
        "print(\"x =\", x)\n",
        "print(\"y =\", y)\n"
      ],
